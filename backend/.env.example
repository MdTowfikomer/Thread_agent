# Thread Configuration Template
# Copy this file to .env and configure your secrets

# Primary LLM Keys (Configure at least one for live neural synthesis; falls back gracefully if empty)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Persistence & Direct DB Connection
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

THREAD_JWT_SECRET=your_jwt_secret_here

PORT=8000

# Supabase Client Credentials
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=your_anon_key_here

# Discord Connector Credentials
DISCORD_APPLICATION_ID=your_discord_application_id_here
DISCORD_PUBLIC_KEY=your_discord_public_key_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_ALLOWED_GUILD_IDS=your_guild_id_1,your_guild_id_2

# GitHub Connector Credentials (Upcoming)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_TOKEN=

# Telegram Events Connector
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
TELEGRAM_ALLOWED_CHAT_IDS=your_telegram_chat_id

# Slack Events API Connector
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_ALLOWED_CHANNEL_IDS=your_bound_slack_channel_id
# Slack app bot scope required for outbound delivery: chat:write
# Do not grant chat:write.public; invite Thread explicitly to each bound channel.
